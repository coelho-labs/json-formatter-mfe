{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": [],
  "tsconfigFile": "tsconfig.app.json",
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/test/**",
    "!src/components/ui/**",
    "!src/lib/utils.ts",
    "!src/components/code-editor/theme.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "ignorePatterns": [
    "dist",
    ".mf",
    "reports"
  ],
  "cleanTempDir": "always",
  "concurrency": "50%",
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "clearTextReporter": {
    "skipFull": true
  }
}